/**
 * @fileoverview Firestore Security Rules for the Pockets application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model. Each user has full control over their own data,
 * and no access to other users' data. Data is nested under the /users/{userId} collection to enforce this.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information.
 * - /users/{userId}/monthlyInfo/{monthlyInfoId}: Stores monthly budget information for a user.
 * - /users/{userId}/dailyExpenses/{dailyExpenseId}: Stores daily expense entries for a user.
 * - /users/{userId}/loans/{loanId}: Stores loan information for a user.
 *
 * Key Security Decisions:
 * - Users can only access their own data.
 * - Users can create their own user document.
 * - Listing of all users is disallowed.
 * - No global admin roles are defined, simplifying the access control model.
 *
 * Denormalization for Authorization:
 * - The 'userId' is denormalized (repeated) within the MonthlyInfo, DailyExpense, and Loan documents.
 *   This duplication allows rules to efficiently verify ownership without needing to traverse the document hierarchy.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces access control for user profiles.
     * @path /users/{userId}
     * @allow (create) User with matching UID can create their profile.
     * @allow (get, update, delete) User with matching UID can read, update, or delete their profile.
     * @deny (create) User cannot create a profile with a mismatched UID.
     * @deny (get, update, delete) User cannot read, update, or delete another user's profile.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false; // Listing users is not permitted.
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Enforces access control for monthly budget information.
     * @path /users/{userId}/monthlyInfo/{monthlyInfoId}
     * @allow (create) User with matching UID can create monthly info under their profile.
     * @allow (get, update, delete) User with matching UID can read, update, or delete their monthly info.
     * @deny (create) User cannot create monthly info with a mismatched UID.
     * @deny (get, update, delete) User cannot read, update, or delete another user's monthly info.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/monthlyInfo/{monthlyInfoId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Enforces access control for daily expense entries.
     * @path /users/{userId}/dailyExpenses/{dailyExpenseId}
     * @allow (create) User with matching UID can create daily expense under their profile.
     * @allow (get, update, delete) User with matching UID can read, update, or delete their daily expense.
     * @deny (create) User cannot create daily expense with a mismatched UID.
     * @deny (get, update, delete) User cannot read, update, or delete another user's daily expense.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/dailyExpenses/{dailyExpenseId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }

     /**
     * @description Enforces access control for loan entries.
     * @path /users/{userId}/loans/{loanId}
     * @allow (create) User with matching UID can create a loan under their profile.
     * @allow (get, update, delete) User with matching UID can read, update, or delete their loan.
     * @deny (create) User cannot create a loan with a mismatched UID.
     * @deny (get, update, delete) User cannot read, update, or delete another user's loan.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/loans/{loanId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }
     
    /**
     * @description Enforces access control for loans given entries.
     * @path /users/{userId}/loansGiven/{loanGivenId}
     * @allow (create) User with matching UID can create a loan given entry under their profile.
     * @allow (get, update, delete) User with matching UID can read, update, or delete their loan given entry.
     * @deny (create) User cannot create a loan given entry with a mismatched UID.
     * @deny (get, update, delete) User cannot read, update, or delete another user's loan given entry.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/loansGiven/{loanGivenId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }
  }
}

    